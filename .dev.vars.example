# 复制为 .dev.vars 供本地 wrangler dev 使用（此文件不提交）
# Cloudflare Workers 面板配置的是正式环境的 GITHUB_TOKEN
GITHUB_TOKEN=your_github_token

# 可选。无 token 时（REST 读取器）索引哪个账号，默认 xmtlzzz。
# GITHUB_LOGIN=xmtlzzz

# 可选。钉住 canonical / og:url / feed / sitemap 使用的正式域名；
# 不配置时按请求域名解析，因此预览部署会使用自己的地址。
# SITE_URL=https://vmaker.xmtlz.dev
