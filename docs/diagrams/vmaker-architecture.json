  "cards": [
    {
      "dot": "cyan",
      "title": "入口与渲染",
      "items": [
        "Worker 只做一件事：把 Cloudflare env / ctx 交给 createRequestHandler",
        "静态资源由 Workers Static Assets 托管 build/client，不进入 SSR",
        "四条路由：索引、项目详情、feed.xml、sitemap.xml"
      ]
    },
    {
      "dot": "emerald",
      "title": "数据读取与降级",
      "items": [
        "GraphQL 用一次 ProjectIndex 拿到仓库、语言与最近 5 条提交，必须有 token",
        "REST 成本 1 + 2N、并发上限 5，是无 token 与失败后的降级路径",
        "内存缓存 TTL 10 分钟，详情页复用同一份 payload，不产生额外请求",
        "GitHub 全部不可用时回退到本地 overrides 派生的数据集，而不是空索引"
      ]
    },
    {
      "dot": "violet",
      "title": "客户端状态",
      "items": [
        "主题 / 强调色 / 语言存 localStorage，内联脚本在 hydration 前应用",
        "搜索与语言分组是纯客户端 useMemo，不触发任何请求",
        "首屏与索引之间的滚动吸附、返回顶部胶囊均为本地交互"
      ]
    }
  ]
}
