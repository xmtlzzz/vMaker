# Optional. Recommended for local development and Vercel to avoid GitHub API rate limits.
GITHUB_TOKEN=your_github_token

# Optional. Which account the REST reader indexes when no token is set (default: xmtlzzz).
# GITHUB_LOGIN=xmtlzzz

# Optional. Pins the canonical origin used by meta tags, the RSS feed and the sitemap.
# Leave it unset to derive the origin from the incoming request (preview-friendly).
# SITE_URL=https://vmaker.xmtlz.dev
